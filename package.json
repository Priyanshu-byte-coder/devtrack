{
  "name": "devtrack",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "validate-env": "node scripts/validate-env.js",
    "build": "npm run validate-env && next build --webpack && node scripts/copy-standalone-static.js && node scripts/check-pwa.mjs",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "supabase:generate-types": "node scripts/generate-database-types.cjs",
    "prepare": "husky",
    "test:node": "node --experimental-strip-types --test test/*.test.js test/*.test.mjs",
    "test:all": "npm test && npm run test:node",
    "security:env": "node scripts/check-env-security.js",
    "test:db": "node scripts/check-database.cjs && node scripts/generate-database-types.cjs --check && node scripts/check-database-contracts.cjs",
    "api:generate": "node scripts/sync-openapi.cjs",
    "api:check": "node scripts/sync-openapi.cjs --check",
    "security:audit": "node scripts/security-audit.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@swc/helpers": "^0.5.23",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.17",
    "driver.js": "^1.9.0",
    "fflate": "^0.8.3",
    "groq-sdk": "^1.6.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "~16.4.0",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "swagger-ui-react": "5.33.2",
    "tailwind-merge": "^3.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@next/env": "16.4.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "tree-sitter": "^0.25.1",
    "typescript": "^6",
    "vitest": "^4.1.11",
    "web-tree-sitter": "^0.27.1"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@img/sharp-linux-x64": "^0.35.5",
    "@parcel/watcher-darwin-arm64": "^2.6.0",
    "@parcel/watcher-darwin-x64": "^2.6.0",
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@parcel/watcher-linux-x64-musl": "^2.6.0",
    "@swc/core-linux-x64-gnu": "^1.16.18"
  },
  "packageManager": "pnpm@11.13.1"
}
