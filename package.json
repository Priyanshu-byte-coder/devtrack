    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "~16.3.2",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.7",
    "next-pwa": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "swagger-ui-react": "5.32.14",
