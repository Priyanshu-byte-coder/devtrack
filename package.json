    "prettier": "^3.9.6",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "tree-sitter": "^0.25.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6",
    "vitest": "^4.1.11",
    "web-tree-sitter": "^0.26.12"
  },
  "engines": {
    "node": "20.x"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@parcel/watcher-darwin-arm64": "^2.6.0",
    "@parcel/watcher-darwin-x64": "^2.6.0",
