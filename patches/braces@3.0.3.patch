new file mode 100644
index 0000000..30fcaf4
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,14 @@
+'use strict';
+// Bound recursive AST walkers, including callers that pass a hand-built AST.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 64 || ++count > 65536 || seen.has(node)) throw new RangeError('Brace pattern exceeds safe complexity');
+    seen.add(node);
+    if (Array.isArray(node.nodes)) for (const child of node.nodes) pending.push([child, depth + 1]);
+  }
+};
